# TIGERIS AI provider configuration (SERVER-SIDE ONLY). Copy to .env.local (git-ignored) and restart the server.
# Without these, the app shows "AI provider not configured" and offers only the clearly labelled deterministic demonstration.
# Never prefix these with NEXT_PUBLIC_ and never commit real values.
ANTHROPIC_API_KEY=
# An explicitly configured model ID from Anthropic's current model list (there is deliberately no default), for example claude-opus-5-5
TIGERIS_AI_MODEL=
# Optional: per-request provider timeout in milliseconds (500–120000, default 45000)
# TIGERIS_AI_TIMEOUT_MS=45000
# Automated tests only (never set in a demo): TIGERIS_AI_TEST_MOCK=1 enables a mock-provider fixture that is labelled "Mocked provider, not AI"

# ───────── ServiceTrace maintenance platform (server-side only; never commit real values) ─────────
# APP_ENV: development | staging | production | test   (staging/production require APP_ENCRYPTION_KEY and secure cookies)
APP_ENV=development
APP_BASE_URL=http://localhost:3000
# Runtime connection: the LOW-PRIVILEGE role trace_app (cannot bypass row-level security)
DATABASE_URL=postgresql://trace_app:CHANGE_ME@localhost:5432/tracedev
# Migrations only: the schema OWNER role. Never give this to the running app in production.
MIGRATE_DATABASE_URL=postgresql://trace_owner:CHANGE_ME@localhost:5432/tracedev
# 32 random bytes as hex or base64 (openssl rand -hex 32). Encrypts MFA secrets at rest. Required outside development.
APP_ENCRYPTION_KEY=
# Evidence storage (local-disk driver). Use an absolute path on a persistent, backed-up volume.
UPLOAD_DIR=.data/uploads
MAX_UPLOAD_BYTES=10485760
# Email. Without both, mail is recorded in the outbox as "not_configured" and nothing is sent.
SMTP_URL=
MAIL_FROM=
# Display time zone for dates (IANA name). Default UTC.
APP_TIMEZONE=UTC
